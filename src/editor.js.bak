  try {
    if (navigator.share) await navigator.share({ url, title });
    else { await navigator.clipboard.writeText(url); toast('تم نسخ الرابط'); }
  } catch {}
};

// تصدير
const _tExport = document.getElementById('tile-export');
if (_tExport) _tExport.onclick = () => {
  closeSettingsSheet();
